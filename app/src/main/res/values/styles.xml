<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppStatusChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="AppActionBar" parent="android:Widget.Material.Light.ActionBar">
        <item name="android:background">@color/color_background</item>
    </style>

    <style name="AppListActionBar" parent="AppActionBar">
        <item name="android:contentInsetStart">64dp</item>
    </style>

    <style name="AppListToolbar" parent="android:Widget.Material.Toolbar">
        <item name="android:contentInsetStart">64dp</item>
        <item name="android:contentInsetStartWithNavigation">64dp</item>
    </style>

    <style name="AppListSearchView" parent="android:Widget.Material.Light.SearchView">
        <item name="android:searchIcon">@null</item>
        <item name="android:queryBackground">@null</item>
    </style>

    <style name="AppListTheme" parent="AppTheme">
        <item name="android:actionBarStyle">@style/AppListActionBar</item>
        <item name="android:toolbarStyle">@style/AppListToolbar</item>
        <item name="android:searchViewStyle">@style/AppListSearchView</item>
    </style>
</resources>